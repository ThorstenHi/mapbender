
<div class="elementFormMap">
    {{ form_row(form.title) }}
    {{ form_row(form.configuration.layersets) }}
    {{ form_row(form.configuration.tileSize) }}
    {{ form_row(form.configuration.srs) }}
    <div class="row">
        {{ form_label(form.configuration.extent_max) }}
        <div class="col-sm-9">
            {{ form_widget(form.configuration.extent_max) }}
            {{ form_errors(form.configuration.extent_max) }}
        </div>
        <div class="col-sm-1">
            {{ form_help(form.configuration.extent_max) }}
        </div>
    </div>
    <div class="row">
        {{ form_label(form.configuration.extent_start) }}
        <div class="col-sm-9">
            {{ form_widget(form.configuration.extent_start) }}
            {{ form_errors(form.configuration.extent_start) }}
        </div>
        <div class="col-sm-1">
            {{ form_help(form.configuration.extent_start) }}
        </div>
    </div>
    {{ form_rest(form.configuration) }}
</div>
<script type="text/javascript">
    $('.elementFormMap .choiceExpandedSortable').sortable({axis: "y"});
</script>
